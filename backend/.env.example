# =============================================================================
# Yarmouk Water Management Pro - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Development (SQLite - zero config)
DATABASE_URL=sqlite+aiosqlite:///./yarmouk_water_pro.db
DATABASE_URL_SYNC=sqlite:///./yarmouk_water_pro.db

# Production (PostgreSQL - recommended)
# DATABASE_URL=postgresql+asyncpg://yarmouk_user:YOUR_PASSWORD@localhost:5432/yarmouk_pro
# DATABASE_URL_SYNC=postgresql://yarmouk_user:YOUR_PASSWORD@localhost:5432/yarmouk_pro

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# JWT SECURITY (CRITICAL)
# =============================================================================
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(64))"
# WARNING: Changing JWT_SECRET_KEY invalidates all existing tokens!
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# SECURITY: Only allow specific origins (NO wildcards in production!)
# Development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Production (add your actual domains)
# CORS_ORIGINS=https://api.yarmouk.com,https://app.yarmouk.com

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=120

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development
DEBUG=false
